# Copy to .env (local) and set the same variables in Vercel → Project → Settings
# → Environment Variables. Never commit the real .env (it's gitignored).

# Google Sheets Apps Script web-app URL that receives Free Audit submissions.
# Create it with the steps in setup_google_sheets.md. Used by /api/audit.
GSHEET_WEBHOOK_URL=

# Optional: override the form POST target in local dev (defaults to /api/audit).
# e.g. VITE_AUDIT_ENDPOINT=http://localhost:3000/api/audit when running server.js
VITE_AUDIT_ENDPOINT=
